# Optional. Export variables in your shell; no secrets belong in frontend/.env.
# OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4.1-mini
# Backend defaults to a local generated SQLite snapshot; no data is regenerated.
GREENLENS_DB=data/processed/greenlens.sqlite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend defaults to Vite /api proxy. For separately hosted UI set VITE_API_BASE.
# Set false to use deterministic explanations without attempting provider calls.
LLM_ENABLED=true
